

# called with this Docker instruction:
# docker run --init --mount type=bind,src=absolutePathToDockerFolder/inout,dst=/inout stoch_gen_image /stoch_gen +v +F /inout/docker_stoch_config_oneSrcOneSnk_12oct2026-17h09_gstd.par


# 1 Main options
#***************

# input file has GSTD format
F G

# input file name
I /inout/determ_oneSrcOneSnk_12oct2026-17h09.std

#output file name
O /inout/stoch_oneSrcOneSnk_12oct2026-17h09_gstd.txt

# all elements of D, A will be randomized
S 3

# correlations are hereafter specified for each block
K

# name of file where correlations will be saved
C /inout/stoch_corrs_oneSrcOneSnk_12oct2026-17h09_gstd.dat

# correlations for each block concerned by S 3
XDD 0.5
XDA -0.2
XAA 0.5

# moments will be generated
G

# moments will be generated according to uniform distributions
T U

# alpha
A 0.35

# beta
B 0.35

# name of file where moments will be saved
M /inout/stoch_moms_oneSrcOneSnk_12oct2026-17h09_gstd.dat

# 2 HKW options
#**************

# number of scenarios
n 500

# maximum number of trials in HKW algo. (default 20)
t 20

# maximum number of iter. in HKW algo. (default 30)
i 30

# maximum error in matching moments (default 0.001)
m 0.001 

# maximum error in matching correlations (default 0.001)
c 0.001

# level of on-screen reporting (default 3)
l 3

# name of file where raw scenarios will be saved
o /inout/stoch_rawscen_oneSrcOneSnk_12oct2026-17h09_gstd.dat

# random seed
r 12345

# random stream
R 200


